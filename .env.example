# YatraAI — required environment variables
# Copy these NAMES into Netlify (Site configuration -> Environment variables).
# Every variable is optional individually — without it, that feature shows an
# honest "not connected" state instead of fake data. See SETUP_REQUIRED.md.

ANTHROPIC_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
